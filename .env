# Blindspot local configuration (this file is gitignored - never commit it)

# --- Firebase project ---
FB_PROJECT_ID=blindspot-1bcc5

# --- Firebase WEB configuration (public values from Project settings > Your apps) ---
FB_WEB_API_KEY=AIzaSyCCIxUHalM7jeGBl6iDVldZkBMiVyLBud4
FB_WEB_AUTH_DOMAIN=blindspot-1bcc5.firebaseapp.com
FB_WEB_PROJECT_ID=blindspot-1bcc5
FB_WEB_APP_ID=1:769058488104:web:68b73eb87f9a1582941a1d
# measurementId G-9MKPK8ZNKW is optional analytics; not needed by the app.

# --- Firebase Admin credentials for the Node backend (STILL REQUIRED) ---
# Download from Firebase console -> Project settings -> Service accounts
# -> "Generate new private key", save it here, then restart the server:
BLINDSPOT_FIREBASE_CREDENTIALS=./secrets/blindspot-service-account.json

# --- Session secret & switches ---
SESSION_SECRET=blindspot-dev-secret-change-me
SESSION_SECURE=false
TRUST_PROXY=false

# --- One-time bootstrap of the FIRST ADMIN (remove after first run!) ---
BLINDSPOT_SETUP_ADMIN_UID=
BLINDSPOT_SETUP_ADMIN_EMAIL=

# --- Demo mode: seed demo employees + demo packages at startup ---
# true = on server start (with Firebase configured), create the 5 demo
# accounts (password demo1234) and 16 demo packages if they don't exist.
BLINDSPOT_AUTO_SEED_DEMO=true

PORT=8080
